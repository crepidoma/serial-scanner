{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "styled-system/*": ["./styled-system/*"]
    }
  },
  "include": ["src/client", "src/shared", "src/bookmarklet", "src/vite-env.d.ts", "styled-system"]
}
